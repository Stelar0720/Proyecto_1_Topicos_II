# Configuración LOCAL y desechable para una demostración. Copia este archivo
# como .env.demo; no lo subas a Git ni lo uses en producción.
DATABASE_URL=sqlite:///./citafacil-demo.db
ADMIN_TOKEN=citafacil-demo-2026
CUSTOMER_AUTH_SECRET=demo-local-secret-no-produccion
DEMO_MODE=true
# Referencia visual: 8.000 CLP = aproximadamente US$8,10.
USD_EXCHANGE_RATE=987.65

# Nunca se envían mensajes reales durante la demo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

FRONTEND_URL=
CORS_ORIGINS=*
